{
  "version": 5,
  "configurePresets": [
    {
      "name": "Release",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
          "type": "FILEPATH"
        },
        "CMAKE_SUPPRESS_DEVELOPER_WARNINGS": true
      }
    },
    {
      "name": "Debug",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
          "type": "FILEPATH"
        },
        "CMAKE_SUPPRESS_DEVELOPER_WARNINGS": true
      }
    },
    {
      "name": "Release x64",
      "inherits": "Release",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "PACKET_LOGGING": false
      }
    },
    {
      "name": "Release x64 MINGW",
      "inherits": "Release",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "PACKET_LOGGING": false,
        "§": "Windows",
        "CMAKE_BUILD_WITH_INSTALL_RPATH": true
      }
    },
    {
      "name": "Debug x64",
      "inherits": "Debug",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "PACKET_LOGGING": false
      }
    },
    {
      "name": "Debug x64 (Packet Logging)",
      "inherits": "Debug",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "PACKET_LOGGING": true
      }
    },
    {
      "name": "Linux Debug x64",
      "inherits": "Debug",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_FORCE_DOWNLOADED_BINARIES": true
      },
      "vendor": {
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "rsyncCommandArgs": [ "-t", "--delete", "--delete-excluded" ],
          "copySourcesOptions": {
            "exclusionList": [
              ".vs",
              ".git",
              "out",
              "build",
              "dependencies/fc"
            ]
          }
        }
      }
    }
  ]
}
