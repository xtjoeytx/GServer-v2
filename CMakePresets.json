{
  "version": 5,
  "configurePresets": [
    {
      "name": "vcpkg",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
          "type": "FILEPATH"
        }
      }
    },
    {
      "name": "release",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CMAKE_SUPPRESS_DEVELOPER_WARNINGS": true,
        "CMAKE_BUILD_WITH_INSTALL_RPATH": false,
        "PACKET_LOGGING": false
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_SUPPRESS_DEVELOPER_WARNINGS": true,
        "CMAKE_BUILD_WITH_INSTALL_RPATH": false,
        "CMAKE_VERBOSE_MAKEFILE": true,
        "PACKET_LOGGING": false
      }
    },
    {
      "name": "releasedebuginfo",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "platform-windows",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "platform-linux",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "platform-osx-gcc",
      "hidden": true,
      "environment": {
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets"
      },
      "cacheVariables": {
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_TARGET_TRIPLET": "arm64-osx-gcc",
        "VCPKG_HOST_TRIPLET": "arm64-osx-gcc"
      }
    },
    {
      "name": "platform-mingw",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": {
          "value": "${sourceDir}/cmake/toolchains/x86_64-mingw64.cmake",
          "type": "FILEPATH"
        },
        "CMAKE_BUILD_WITH_INSTALL_RPATH": true
      }
    },
    {
      "name": "Release MINGW",
      "hidden": true,
      "inherits": [ "platform-mingw", "release", "vcpkg" ]
    },
    {
      "name": "Windows Release",
      "inherits": [ "platform-windows", "release", "vcpkg" ]
    },
    {
      "name": "Windows Debug",
      "inherits": [ "platform-windows", "debug", "vcpkg" ]
    },
    {
      "name": "Windows Debug (Packet Logging)",
      "inherits": [ "platform-windows", "debug", "vcpkg" ],
      "cacheVariables": {
        "PACKET_LOGGING": true
      }
    },
    {
      "name": "Linux Release",
      "inherits": [ "platform-linux", "release", "vcpkg" ]
    },
    {
      "name": "Linux Debug",
      "inherits": [ "platform-linux", "debug", "vcpkg" ]
    },
    {
      "name": "OSX GCC Debug",
      "inherits": [ "platform-osx-gcc", "debug", "vcpkg" ]
    },
    {
      "name": "Linux Remote Release Debug Info",
      "inherits": [ "platform-linux", "releasedebuginfo", "release", "vcpkg" ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "linux-gcc-x64"
        },
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "rsyncCommandArgs": [ "-t", "--delete", "--delete-excluded" ],
          "copySourcesOptions": {
            "exclusionList": [
              ".vs",
              ".git",
              "out",
              "build",
              "dependencies/fc"
            ]
          }
        }
      }
    },
    {
      "name": "Linux Remote Debug",
      "inherits": [ "platform-linux", "debug", "vcpkg" ],
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "linux-gcc-x64"
        },
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "rsyncCommandArgs": [ "-t", "--delete", "--delete-excluded" ],
          "copySourcesOptions": {
            "exclusionList": [
              ".vs",
              ".git",
              "out",
              "build",
              "dependencies/fc"
            ]
          }
        }
      }
    }
  ]
}
